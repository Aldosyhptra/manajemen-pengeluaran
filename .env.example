# Salin menjadi .env.local untuk pengembangan LOKAL.
# JANGAN pernah mengisi file di folder proyek dengan kredensial production.
DATABASE_URL=postgresql://app_web:***@localhost:5433/pengeluaran_dev
SESSION_SECRET=ganti-min-32-karakter-acak-untuk-lokal-xxxx
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat
N8N_WEBHOOK_SECRET=ganti-secret-a-lokal
N8N_PERSONA_URL=http://localhost:5678/webhook/persona
N8N_PERSONA_SECRET=ganti-secret-b-lokal
CHAT_FAKE=true
PERSONA_FAKE=true

# Production: diisi HANYA lewat dashboard Vercel (tidak pernah di file proyek):
# DATABASE_URL (role app_web, tambahkan ?sslmode=require), SESSION_SECRET,
# N8N_WEBHOOK_URL, N8N_WEBHOOK_SECRET, N8N_PERSONA_URL, N8N_PERSONA_SECRET
